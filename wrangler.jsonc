{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appr",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2d8aa82e-7997-4adb-9b94-2747b3eb7714","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "777c3be963c7494e9b061f9c4ae543c4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
